# Example secrets file for push-secrets.sh
#
# Usage:
#   push-secrets.sh --secrets-file .secrets.example
#   push-secrets.sh --secrets-file ~/secrets/common.secrets --secrets-file .secrets
#
# Rules:
#   - Lines annotated with "# var" are pushed as repo variables (plain text)
#   - Everything else is pushed as an encrypted secret
#   - Empty values are skipped
#   - Later files win on duplicate keys when merging multiple files

# ── DigitalOcean ────────────────────────────────────────────────────────────
DIGITALOCEAN_ACCESS_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPACES_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
SPACES_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx           # var
CLOUDFLARE_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Docker / Container Registry ─────────────────────────────────────────────
DOCR_REGISTRY=my-registry                                        # var
DO_REGION=nyc3                                                   # var
AWS_REGION=us-east-1                                             # var

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx          # var

# ── Application secrets ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ── GitHub ───────────────────────────────────────────────────────────────────
# PAT with repo read access (for private Go modules, etc.)
GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
